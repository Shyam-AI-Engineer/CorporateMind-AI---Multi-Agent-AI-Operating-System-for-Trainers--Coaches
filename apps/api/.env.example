# ══════════════════════════════════════════════════════════════════════════════
#  CorporateMind AI — API Environment Variables
#  Copy this file to .env and fill in the values.
#  Never commit .env to git. Production secrets live in Doppler / Railway.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-at-least-32-chars-long-random-string
APP_ALLOWED_HOSTS=["http://localhost:3000","http://localhost:8000"]

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://corpmind:corpmind@localhost:5432/corpmind_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Qdrant (vector store) ──────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                # leave empty for local

# ── Meilisearch ────────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=corpmind-local-master-key

# ── Euri AI Gateway ────────────────────────────────────────────────────────────
EURI_API_KEY=your-euri-api-key-here
EURI_API_BASE_URL=https://api.euricom.io/v1
EURI_TIMEOUT_SECONDS=60
EURI_MAX_RETRIES=3

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Local dev: Mailhog (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@corpmind.local
SMTP_USE_TLS=false
# Domain injected as the right-hand side of outbound SMTP Message-ID headers.
# Format: <ULID@MAIL_DOMAIN>  — must be a domain you control so replies route correctly.
# Auto-derived from SMTP_FROM_ADDRESS when left blank; required in production.
MAIL_DOMAIN=                   # e.g. corpmind.ai

# ── WhatsApp Business Cloud API ────────────────────────────────────────────────
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=local-verify-token
WHATSAPP_WEBHOOK_SECRET=local-webhook-secret

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=local-telegram-secret

# ── Instagram / Facebook Graph API ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_SECRET=local-meta-secret

# ── LinkedIn ───────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Cloudinary (file storage) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Observability ──────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3030   # self-hosted in dev
SENTRY_DSN=                           # leave empty in dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=DEBUG

# ── Feature Flags ──────────────────────────────────────────────────────────────
# Overrides for local dev — production reads from DB
FEATURE_FLAG_OVERRIDE_ALL_OFF=false

# ── AI Cost Governance ─────────────────────────────────────────────────────────
AI_DEFAULT_BUDGET_INR=400             # Starter tier default
AI_SEMANTIC_CACHE_THRESHOLD=0.96      # cosine similarity floor for cache hit

# ── Google OAuth (Gmail inbox integration) ─────────────────────────────────────
# Register at https://console.cloud.google.com/ → APIs & Services → Credentials
# Required scopes: openid email https://www.googleapis.com/auth/gmail.readonly
# Leave empty in dev to disable Gmail connect; endpoints raise 422 when unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/inbox/callback

# ── Inbox / Field Encryption ───────────────────────────────────────────────────
# AES-256-GCM column-level encryption for inbox_messages and inbox_connections.
# Format: version[1] || nonce[12] || ciphertext[N] || tag[16], stored as base64url.
#
# Generate a key:  python -c "import os; print(os.urandom(32).hex())"
# Required in production (startup fails without it).
# Leave empty in local dev — inbox encrypt/decrypt will raise if called without a key.
INBOX_ENCRYPTION_KEY_V1=             # 64 hex chars = 32 bytes
INBOX_ENCRYPTION_KEY_VERSION=1       # bump to 2 after rotating; old rows auto-decrypt via version byte
